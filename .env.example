# Optional market-data API origin override. Defaults to Binance public spot market data.
NEXT_PUBLIC_MARKET_DATA_BASE_URL=https://api.binance.com

# Server-side origin of the separately deployed FastAPI backend (never NEXT_PUBLIC).
PATTERNVIEW_API_URL=http://localhost:8000

# Backend API CORS/rate-limit defaults for local development; configure separately in Render.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
